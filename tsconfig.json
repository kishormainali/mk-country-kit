{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@mkishor/mk-country-kit": ["packages/data/src/index.ts"],
      "@mkishor/mk-country-kit-core": ["packages/core/src/index.ts"],
      "@mkishor/mk-country-kit-ui": ["packages/ui/src/index.ts"],
      "@mkishor/mk-country-kit-react": ["packages/react/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "packages/*/dist", "packages/react/demo"]
}
