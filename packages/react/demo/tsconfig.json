{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@mkishor/mk-country-kit": ["../../data/src/index.ts"],
      "@mkishor/mk-country-kit-core": ["../../core/src/index.ts"],
      "@mkishor/mk-country-kit-ui": ["../../ui/src/index.ts"],
      "@mkishor/mk-country-kit-react": ["../src/index.ts"]
    }
  },
  "include": ["src", "../src", "../../ui/src"]
}
