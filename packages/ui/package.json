{
  "name": "@mkishor/mk-country-kit-ui",
  "version": "1.0.1",
  "type": "module",
  "description": "Premium Shadcn/UI (Tailwind CSS + Radix UI) components for react-country-kit.",
  "author": "Kishor Mainali",
  "license": "MIT",
  "keywords": [
    "react",
    "country-picker",
    "currency-picker",
    "timezone-picker",
    "language-picker",
    "division-picker",
    "country",
    "currency",
    "timezone",
    "shadcn",
    "tailwindcss",
    "radix-ui",
    "react-country-kit",
    "mk-country-kit"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "build:types": "tsc --emitDeclarationOnly"
  },
  "peerDependencies": {
    "@radix-ui/react-popover": ">=1.0.0",
    "class-variance-authority": ">=0.7.0",
    "clsx": ">=2.0.0",
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0",
    "tailwind-merge": ">=2.0.0",
    "tailwindcss": ">=3.0.0"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.8",
    "@mkishor/mk-country-kit-core": "^1.0.1"
  },
  "devDependencies": {
    "@radix-ui/react-popover": "^1.1.19",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3"
  },
  "homepage": "https://github.com/kishormainali/mk-country-kit#readme",
  "bugs": {
    "url": "https://github.com/kishormainali/mk-country-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kishormainali/mk-country-kit.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  }
